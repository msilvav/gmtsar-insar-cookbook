# config.env — Ejemplo GRECIA (ejemplo oficial GMTSAR S1_TOPS_Frame)
# Par S1A 2015-11-05 / 2015-11-17 (12 dias). DEM ya incluido en topo/dem.grd.
# source config.env  ANTES de run.sh / unwrap.sh / deramp.sh / export_products.sh

# --- Identidad ---------------------------------------------------------------
export EXP_NAME="greece_2015"
export AOI_DESC="Grecia"               # consumido por quicklook_*.py (titulo del grafico)

# --- Par interferometrico  [run.sh] ------------------------------------------
export M_SAFE="S1A_IW_SLC__1SDV_20151105T163133_20151105T163201_008472_00BFA6_D862.SAFE"
export M_EOF="S1A_OPER_AUX_POEORB_OPOD_20151125T122020_V20151104T225943_20151106T005943.EOF.txt"
export A_SAFE="S1A_IW_SLC__1SDV_20151117T163127_20151117T163155_008647_00C499_5DC1.SAFE"
export A_EOF="S1A_OPER_AUX_POEORB_OPOD_20151207T122501_V20151116T225943_20151118T005943.EOF.txt"
export POL="vv"
export CONFIG="config.txt"             # el config de este ejemplo se llama config.txt (no config.s1a.txt)
export PARALLEL="1"                    # 3 subswaths en paralelo (22 cores disponibles)

# --- Fechas  [export_products.sh] --------------------------------------------
export M_DATE="2015-11-05"
export S_DATE="2015-11-17"

# --- Desenrollado SNAPHU  [unwrap.sh] ----------------------------------------
export THRESH="0.1"
export DEFOMAX="0"
export TGEO="0.10"
export SNAPHU_MODE="plain"

# --- Deramp  [deramp.sh] -----------------------------------------------------
export NMODEL="3"

# --- Fisica / salidas  [export_products.sh, datacube.py] ---------------------
export WAVELENGTH="0.0554658"          # banda C S1
export OUT_CRS="EPSG:4326"
export UTM_EPSG="32634"                # UTM 34N provisional (Grecia ~20-24E); ajustar tras ver el bbox

# --- Entorno -----------------------------------------------------------------
export GMTSAR="/usr/local/GMTSAR"
export LC_ALL="C"
export PY="/home/manuel/miniconda3/envs/geoai/bin/python"

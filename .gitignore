__pycache__/
*.pyc
*.pyo

# --- Local per-experiment config (copied from config.template) ---------------
config.env

# --- OS / editor junk --------------------------------------------------------
.DS_Store
._*
*.swp

# --- Logs --------------------------------------------------------------------
*.log

